{
  "name": "riwaq",
  "version": "0.48.0",
  "private": true,
  "type": "module",
  "description": "Riwaq — an Arabic-first desktop client for the Stremio addon ecosystem",
  "author": "Riwaq contributors",
  "license": "MIT",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:web": "vite build --config vite.web.config.mjs",
    "dev:web": "vite --config vite.web.config.mjs",
    "start": "electron .",
    "admin": "electron admin/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src core electron tests scripts web server admin announcements",
    "check": "prettier --check src core electron tests scripts web server admin announcements",
    "package:admin": "electron-builder --config admin/electron-builder.json --win portable --x64 --publish never",
    "package": "npm run build && node node_modules/electron/install.js && electron-builder --win nsis portable --x64 --publish never",
    "release:sign": "node scripts/sign-release.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "latest",
    "7zip-bin": "^5.2.0",
    "buffer": "^6.0.3",
    "electron": "44.4.1",
    "electron-builder": "^26.0.12",
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "prettier": "^3.9.7",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "app.riwaq.desktop",
    "productName": "Riwaq",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY.md",
      "!node_modules/@koromix/koffi-!(win32)-*/**",
      "!node_modules/**/prebuilds/!(win32-x64)/**",
      "!node_modules/node-datachannel/{src,cmake,test,BULDING.md}/**"
    ],
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Riwaq-${version}-win-x64.exe"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/node-datachannel/**",
      "node_modules/utp-native/**",
      "node_modules/bufferutil/**",
      "node_modules/utf-8-validate/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Riwaq-Setup-${version}-win-x64.exe"
    },
    "npmRebuild": false
  }
}
